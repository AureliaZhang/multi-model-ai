# ─────────────────────────────────────────────────────────────────────────────
# multi-model-ai 服务端环境变量样例
#
# 这份文件是**模板**，只列变量名、默认值和含义，不含任何真实密钥 —— 可以进 git。
#
# 生产部署不用手抄这个文件：`deploy.sh` 首次运行会自动生成
# `~/.multi-model-ai.env`（chmod 600，随机密钥，永不覆盖已有文件）。
# 这份样例是给「本地开发」和「看一眼到底有哪些开关」用的。
#
# ⚠️ 本地开发想用的话：复制成 server/.env 再填，**别把 .env 提交上去**。
# ⚠️ 生产环境的 ENCRYPTION_KEY 一旦丢失，库里已加密的中转站 API key
#    **再也解不开**（会报 "Unsupported state or unable to authenticate data"）。
#    换这个值等于作废所有已存的节点密钥。
# ─────────────────────────────────────────────────────────────────────────────

# ── 必填（生产环境）────────────────────────────────────────────────────────────

# 签发 / 校验登录 token。生产环境不设会拒绝启动（不允许用内置默认值）。
# 生成：openssl rand -hex 32
JWT_SECRET=

# 加密落库的中转站 API key（AES-256-GCM）。见上方警告：不可丢、不可换。
# 生成：openssl rand -hex 32
ENCRYPTION_KEY=

# 首任管理员（用户名固定为 admin）的初始密码。生产环境不设会拒绝启动，
# 以免留下默认弱密码。首次登录后建议在页面里再改一次。
ADMIN_PASSWORD=

# ── 运行环境 ─────────────────────────────────────────────────────────────────

# production 时：启用上面三项的强制校验，并接管 client/dist 静态文件服务。
NODE_ENV=development

# 监听端口。默认 3001；线上 deploy.sh 用 8500（Oracle 放行的 8000-9000 段内）。
PORT=3001

# 允许的前端来源（CORS）。留空 = 只允许同源，也就是由本服务自己发的前端。
# 线上填站点域名，例如 https://official.aureliazhsy.com
CORS_ORIGIN=

# ── 数据位置 ─────────────────────────────────────────────────────────────────

# SQLite 数据库文件。默认 server/data/app.db。
# 填 :memory: 会跑纯内存库（测试用，同时会自动关掉备份任务）。
DB_PATH=

# 上传文件目录。默认 server/data/uploads。
UPLOADS_PATH=

# ── 自动备份 ─────────────────────────────────────────────────────────────────

# 默认**开启**（数据安全优先）。填 0/false/no/off 才关掉。
BACKUP_ENABLED=1

# 快照目录。默认是数据库文件旁边的 backups/。
#
# ⚠️ 强烈建议在生产环境把它指到**代码仓库外面**：默认位置在 git 检出目录里，
#    一次 `git clean -fdx` 会把数据库和全部备份一起清掉。
#    例如：BACKUP_DIR=/var/lib/multi-model-ai/backups
BACKUP_DIR=

# 快照间隔（毫秒）。默认 24 小时。
BACKUP_INTERVAL_MS=

# 保留最近几份快照；0 = 全都留着。默认 7。
BACKUP_KEEP=

# ── 注册策略 ─────────────────────────────────────────────────────────────────

# 设为 1 = 邀请制：注册必须带管理员生成的邀请码。默认开放注册。
# REQUIRE_INVITE=1

# ── 限流 ─────────────────────────────────────────────────────────────────────

# 每 IP 每分钟允许的聊天请求数。默认 60。
RATE_LIMIT_CHAT_PER_MIN=60

# 竞技场（一次打多个模型）每 IP 每分钟允许的请求数。默认 120。
RATE_LIMIT_ARENA_PER_MIN=120

# 竞技场单次并发调用上限。默认见 utils/asyncPool.ts。
ARENA_CONCURRENCY=

# ── 后台探测任务（默认全关）───────────────────────────────────────────────────
#
# ⚠️ 保持关闭。曾有中转站因为我们周期性探测而**封禁了账号**（v0.7.97）。
#    节点健康状态现在改由真实流量推导，不需要主动探。
#    只有在你确认目标中转站允许探测时才打开。

# 设为 1 开启周期性健康检查。
HEALTH_CHECK_ENABLED=0

# 健康检查间隔（毫秒）。仅在上面开启时有意义。
HEALTH_CHECK_INTERVAL_MS=

# 设为 1 开启每日深度探测（逐模型能力嗅探，请求量比健康检查大得多）。
DEEP_PROBE_ENABLED=0

# ── 可选：内置 MiMo 赠送节点 ─────────────────────────────────────────────────
#
# 两项都填才会在首次启动时自动种一个 MiMo 节点。不填就跳过，
# 中转站照常在页面里手动添加。

MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-ams.xiaomimimo.com/v1
